/skills/
# ---- Multi-MT5 Trade Copier repo hygiene ----
# runtime database files (keep the folder via .gitkeep)
db/*.db
db/*.db-journal
# sandbox-only folders (not part of the product)
/agent-ctx
/download
/examples
/mini-services
/tests
# allow the env example
!.env.example

# ---- Windows packaging build artifacts ----
deploy/worker/build/
deploy/worker/dist/
deploy/installer/Output/
# python bytecode
__pycache__/
*.pyc

# chat upload folder (not project content)
/upload/
